# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Supabase (Project Settings > API in the Supabase dashboard).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to SIGN student session tokens (the Bearer token the Android
# app stores after login). Generate a long random string — e.g.
# `openssl rand -hex 32` — and never reuse it elsewhere.
JWT_SECRET=

# Monime (Settings > API Keys in the Monime dashboard). The access token
# and webhook secret must never reach the Android app or any frontend.
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=
# Confirm this from a real test webhook's headers before relying on it —
# see the README's "Confirming the webhook signature header" section.
MONIME_SIGNATURE_HEADER=monime-signature

PORT=4000
